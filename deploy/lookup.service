# ============================================================================
# lookup.service (재작성판) — 조회 서버 systemd 유닛
#
# 설치 (VPS 에서):
#   sudo cp lookup.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now lookup
# 상태/로그:
#   systemctl status lookup
#   journalctl -u lookup -f
#
# 주의: systemd 는 $HOME 을 확장하지 않으므로 아래는 전부 절대 경로다.
#       Oracle Ubuntu 이미지의 기본 사용자 ubuntu 기준 — 다르면 세 곳
#       (User, WorkingDirectory, 경로들)을 함께 바꿀 것.
# ============================================================================

[Unit]
# 유닛 설명
Description=Private phishing lookup server (OpenFHE BFV)
# 네트워크가 올라온 뒤에 시작한다
After=network-online.target
Wants=network-online.target

[Service]
# 실행 사용자 (root 로 돌릴 이유가 없다)
User=ubuntu
# 작업 디렉터리 (feed_hv.csv 를 여기서 찾는다)
WorkingDirectory=/home/ubuntu/lookup
# 측정으로 확정된 배포 구성: 이 워크로드에서 OpenMP 병렬화는 손해 (14배 차이 실측)
Environment=OMP_NUM_THREADS=1
# OpenFHE 공유 라이브러리 경로 (rpath 보강)
Environment=LD_LIBRARY_PATH=/home/ubuntu/local/lib
# 서버 실행 명령 (60초 mtime 감시로 feed_hv.csv 갱신을 자동 반영)
ExecStart=/home/ubuntu/lookup/lookup_server --values /home/ubuntu/lookup/feed_hv.csv --port 8080
# 비정상 종료 시 5초 뒤 재시작
Restart=on-failure
RestartSec=5

[Install]
# 통상 부팅 대상에 연결한다
WantedBy=multi-user.target
